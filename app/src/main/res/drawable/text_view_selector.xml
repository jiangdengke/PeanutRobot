<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_lilac" />
            <stroke android:width="1dp" android:color="@color/ui_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_lilac_pressed" />
            <stroke android:width="1dp" android:color="@color/ui_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_lilac_pressed" />
            <stroke android:width="1dp" android:color="@color/ui_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <stroke android:width="1dp" android:color="@color/ui_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
